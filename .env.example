# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. (.env는 절대 커밋하지 마세요)

# Gemini API 키 (필수) - https://aistudio.google.com/apikey
# 사건 병합(event_dedup)·분석(5_analyze)·이슈 요약(issue_digest)·LLM 검수(7_watch)에 쓰인다.
# 키가 없으면 LLM 단계는 건너뛰거나 실패하고, 키워드 기반 단계만 동작한다.
GEMINI_API_KEY=your_gemini_api_key
# 모델 변경 (선택) - 기본값은 gemini_client.py 참고
# GEMINI_MODEL=
# GEMINI_FAST_MODEL=

# 수신자 (공통) - 쉼표로 구분. Outlook/SMTP 둘 다 사용
EMAIL_RECIPIENTS=team@example.com,me@example.com

# 자가진단 리포트 수신자 (선택) - 8_send_watch_report.py. 없으면 조용히 건너뜀
# WATCH_REPORT_TO=operator@example.com

# 이메일 발송(SMTP) 설정 - Gmail은 앱 비밀번호 사용
# (회사 Outlook 계정이면 SMTP 대신 'python 4_send_email.py --outlook' 권장)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# 텔레그램 전송 (선택) - @BotFather 로 봇 생성 후 토큰, --getid 로 chat_id 확인
TELEGRAM_BOT_TOKEN=123456:ABC-your_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# 네이버 검색 API (선택) - https://developers.naver.com 에서 애플리케이션 등록 후 발급
# 없으면 네이버 뉴스 수집만 자동으로 건너뜀
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
