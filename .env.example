# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. (.env는 절대 커밋하지 마세요)

# Groq API 키 (5_analyze.py 필수) - https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# 수신자 - 쉼표로 구분. Outlook/SMTP 둘 다 사용
EMAIL_RECIPIENTS=someone@example.com,team@example.com

# 이메일 발송(SMTP) 설정 - Gmail은 앱 비밀번호 사용
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# 텔레그램 전송 (선택) - @BotFather 로 봇 생성 후 토큰, --getid 로 chat_id 확인
TELEGRAM_BOT_TOKEN=123456:ABC-your_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# 네이버 검색 API (선택) - https://developers.naver.com 에서 발급
# 없으면 네이버 뉴스 수집만 자동으로 건너뜀
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# (선택) 다른 프로필 파일 사용
# PROFILE_PATH=profiles/my_team.json
